# QA Copilot server configuration. Copy to .env and fill in.

# Which provider to use: anthropic | openai | local | openrouter
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Local model via any OpenAI-compatible server (Ollama, LM Studio, llama.cpp, vLLM...)
# Base URL must include the /v1 path. Examples:
#   Ollama:    http://localhost:11434/v1
#   LM Studio: http://localhost:1234/v1
LOCAL_BASE_URL=
LOCAL_MODEL=
LOCAL_API_KEY=        # usually blank; set only if your server requires a token

# Reasoning models (e.g. Qwen3) emit "thinking" tokens that can consume the whole
# output budget and leave the answer empty (502 "Local LLM returned no content").
# Thinking is OFF by default for the local provider. Set to true to re-enable it
# (vLLM/SGLang only — sends chat_template_kwargs.enable_thinking).
LOCAL_ENABLE_THINKING=false
LOCAL_MAX_TOKENS=        # optional output token cap (default 2048); raise for long reports. 4096–8192 is the sweet spot
LOCAL_TIMEOUT_MS=        # optional request timeout in ms (default 120000)

# OpenRouter (https://openrouter.ai — OpenAI-compatible gateway to many models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=        # required, vendor/model form, e.g. anthropic/claude-sonnet-4-6

# HTTP port the extension talks to (matches the extension's default backend URL)
PORT=8787

# Log verbosity: error | warn | info | debug (default info). `debug` also logs
# full (redacted) LLM prompt/response bodies. Never logs API keys or headers.
LOG_LEVEL=info
