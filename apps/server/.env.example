# QA Copilot server configuration. Copy to .env and fill in.

# Which provider to use: anthropic | openai
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# HTTP port the extension talks to (matches the extension's default backend URL)
PORT=8787
